@model EmployeeDocumentPageViewModel
@{
    Layout = "_Layout2";
    ViewBag.Title = "Documents";
}

<div class="document-page">
        <!-- Category Navigation -->
        <div class="category-nav mb-4">
        @foreach (var category in Model.Categories)
        {
            <button type="button" 
            class="category-btn @(category.Id == Model.Categories.First().Id ? "active" : "")"
            data-categoryid="@category.Id">
            <i class="@category.IconClass"></i> @category.Name
            </button>
        }
        </div>

        <div id="documentCardsContainer">
            <partial name="_DocumentCardsPartial" model="Model.DocumentTypes" />
        </div>

        <!-- Verification -->
        <div class="verification-box mt-5">
            <div class="d-flex gap-3">
                <i class="bi bi-info-circle-fill"></i>

                <div>
                    <h6>Verification Requirement</h6>
                    <p>
                        Please ensure all mandatory documents marked with *
                        are uploaded in high resolution.
                    </p>
                </div>
            </div>
        </div>
</div>