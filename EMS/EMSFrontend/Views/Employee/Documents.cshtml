@{
    Layout = "_Layout2";
    ViewBag.Title = "Documents";
}

<div class="document-page">
        <!-- Header -->
        <div class="top-bar">
            <div>
                <h2>Document Management</h2>
            </div>
        </div>
        <!-- Category Navigation -->
        <div class="category-nav mb-4">
            <button class="active">
                <i class="bi bi-person-badge"></i>
                Identity
            </button>

            <button>
                <i class="bi bi-mortarboard"></i>
                Education
            </button>

            <button>
                <i class="bi bi-briefcase"></i>
                Employment
            </button>

            <button>
                <i class="bi bi-patch-check"></i>
                Professional
            </button>

            <button>
                <i class="bi bi-bank"></i>
                Bank
            </button>

            <button>
                <i class="bi bi-shield-check"></i>
                Legal
            </button>
        </div>

        <!-- Upload Grid -->
        <div class="row g-4">

            <!-- Card -->
            <div class="col-md-6 col-lg-4">
                <div class="document-card">

                    <div class="card-top">
                        <div>
                        <h5>National ID Card <small class="mandatory-doc-mark">*</small></h5>
                        </div>
                    </div>
                    <form method="post" enctype="multipart/form-data">
                        <input type="file" id="imageUpload" hidden accept="image/*, audio/*, video/*, .pdf, .doc, .docx">
                        <div class="upload-box">
                            <div class="upload-icon">
                                <i class="bi bi-cloud-upload"></i>
                            </div>

                            <p class="upload-title">
                                Drop your file here
                            </p>

                            <small>
                                Supported: All image formats, PDF, DOC, DOCX <br>
                                Maximum file size: 5MB
                            </small>

                            <button class="btn btn-light mt-3">
                                Browse File
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Passport -->
            <div class="col-md-6 col-lg-4">
                <div class="document-card">

                    <div class="card-top">
                        <div>
                        <h5>Passport <small class="mandatory-doc-mark">*</small></h5>
                        </div>
                    </div>
                    <form method="post" enctype="multipart/form-data">
                        <input type="file" id="imageUpload" class="file-upload" accept="image/*, audio/*, video/*, .pdf, .doc, .docx">
                        <div class="upload-box">
                            <div class="upload-icon">
                                <i class="bi bi-cloud-upload"></i>
                            </div>

                            <p class="upload-title">
                                Drag and drop file
                            </p>

                            <small>
                                Supported: All image formats, PDF, DOC, DOCX <br>
                                Maximum file size: 5MB
                            </small>

                            <button class="btn btn-light mt-3">
                                Browse File
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Verification -->
        <div class="verification-box mt-5">
            <div class="d-flex gap-3">
                <i class="bi bi-info-circle-fill"></i>

                <div>
                    <h6>Verification Requirement</h6>
                    <p>
                        Please ensure all mandatory documents marked with *
                        are uploaded in high resolution.
                    </p>
                </div>
            </div>
        </div>
</div>