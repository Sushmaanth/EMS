@using EMSFrontend.Models.Leavemodels
@model ApplyLeavePageViewModel

@{
    Layout = "_EmployeeLayout";

    ViewData["Title"] = "Apply Leave";

    var totalLeaves = Model.MyLeaves.Count();

    var approvedLeaves = Model.MyLeaves
        .Count(x => x.Status == "Approved");

    var pendingLeaves = Model.MyLeaves
        .Count(x => x.Status == "Pending");

    var rejectedLeaves = Model.MyLeaves
        .Count(x => x.Status == "Rejected");
}

<div class="leave-summary-grid">

    <div class="leave-summary-card leave-total-card">
        <h3>@totalLeaves</h3>
        <span>Total Requests</span>
    </div>

    <div class="leave-summary-card leave-approved-card">
        <h3>@approvedLeaves</h3>
        <span>Approved</span>
    </div>

    <div class="leave-summary-card leave-pending-card">
        <h3>@pendingLeaves</h3>
        <span>Pending</span>
    </div>

    <div class="leave-summary-card leave-rejected-card">
        <h3>@rejectedLeaves</h3>
        <span>Rejected</span>
    </div>

</div>

<div class="leave-page">

    <div class="dashboard-card">
        <div class="card-header">
            <h5>
                <i class="bi bi-calendar-plus me-2"></i>
                Apply Leave
            </h5>
        </div>

        <form asp-action="Apply"
              asp-controller="Leave"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row g-3">

                <div class="col-md-4">
                    <label asp-for="ApplyLeave.LeaveType"
                           class="form-label">
                        Leave Type
                    </label>

                    <select asp-for="ApplyLeave.LeaveType"
                            class="form-select">

                        <option value="">
                            Select Leave Type
                        </option>

                        <option value="1">
                            Casual Leave
                        </option>

                        <option value="2">
                            Sick Leave
                        </option>

                        <option value="3">
                            Earned Leave
                        </option>

                        <option value="4">
                            Unpaid Leave
                        </option>

                    </select>

                    <span asp-validation-for="ApplyLeave.LeaveType"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ApplyLeave.StartDate"
                           class="form-label">
                        From Date
                    </label>

                    <input asp-for="ApplyLeave.StartDate"
                           type="date"
                           value=""
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="form-control"/>

                    <span asp-validation-for="ApplyLeave.StartDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ApplyLeave.EndDate"
                           class="form-label">
                        To Date
                    </label>

                    <input asp-for="ApplyLeave.EndDate"
                           type="date"
                           value=""
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="form-control" />

                    <span asp-validation-for="ApplyLeave.EndDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-12">
                    <label asp-for="ApplyLeave.Reason"
                           class="form-label">
                        Reason
                    </label>

                    <textarea asp-for="ApplyLeave.Reason"
                              rows="4"
                              class="form-control"
                              placeholder="Enter reason for leave">
                </textarea>

                    <span asp-validation-for="ApplyLeave.Reason"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-12">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>
                        Apply
                    </button>
                </div>

            </div>

        </form>
    </div>

    <div class="dashboard-card mt-4">

        <div class="card-header">
            <h5>
                <i class="bi bi-list-check me-2"></i>
                My Leaves
            </h5>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle" id="applied-leaves">

                <thead>
                    <tr>
                        <th>Leave Type</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th>Total Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.MyLeaves.Any())
                    {
                        @foreach (var leave in Model.MyLeaves)
                        {
                            <tr>

                                <td>@leave.LeaveType</td>

                                <td>
                                    @leave.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @leave.EndDate.ToString("dd MMM yyyy")
                                </td>

                                <td>@leave.TotalDays</td>

                                <td>
                                    @(leave.Reason.Length > 40
                                        ? leave.Reason.Substring(0, 40) + "..."
                                        : leave.Reason)
                                </td>

                                <td>
                                    @{
                                        var badgeClass =
                                            leave.Status == "Approved"
                                            ? "bg-success"
                                            : leave.Status == "Rejected"
                                            ? "bg-danger"
                                            : "bg-warning text-dark";
                                    }

                                    <span class="badge @badgeClass">
                                        @leave.Status
                                    </span>
                                </td>

                                <td>
                                    @leave.AppliedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@leave.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (leave.Status == "Pending")
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@leave.Id"
                                               class="btn btn-sm btn-outline-secondary">

                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger cancel-leave-btn"
                                                    data-id="@leave.Id">

                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">

                                No leave requests found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
@if (TempData["LeaveAppliedSuccessMessage"] != null)
{
    <input type="hidden"
           id="leaveAppliedSuccessMessage"
           value="@TempData["LeaveAppliedSuccessMessage"]" />
}
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
