@using System.Text.Json
@model EmployeeBulkUploadViewModel
@{
    ViewData["Title"] = "Bulk Upload";
}
<div class="card shadow border-0 upload-section">

    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold">
            Employee Bulk Upload
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="BulkUpload"
              method="post"
              enctype="multipart/form-data">

            <div class="row align-items-end g-3">

                <div class="col-lg-3">
                    <a asp-action="DownloadTemplate"
                       class="btn btn-success w-100">
                        <i class="bi bi-download me-1"></i>
                        Download Template
                    </a>
                </div>

                <div class="col-lg-7">
                    <label class="form-label fw-semibold">
                        Select Employee File
                    </label>

                    <input asp-for="File"
                           type="file"
                           class="form-control" />

                    <span asp-validation-for="File"
                          class="text-danger"></span>
                </div>

                <div class="col-lg-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-upload me-1"></i>
                        Upload
                    </button>
                </div>

            </div>

            <div class="mt-3">
                <small class="text-muted">
                    Supported format: .xlsx | Maximum 100 records
                </small>
            </div>

        </form>

    </div>

</div>

@if (Model?.Result != null)
{
    <div class="row mt-3">

        <div class="col-md-4">
            <div class="summary-card total-card">
                <h2>@Model.Result.TotalRecords</h2>
                <span>Total Records</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card success-card">
                <h2>@Model.Result.SuccessRecords</h2>
                <span>Success Records</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="summary-card failed-card">
                <h2>@Model.Result.FailedRecords</h2>
                <span>Failed Records</span>
            </div>
        </div>

    </div>
}

@if (Model?.Result?.Errors.Any() == true)
{
    <div class="card mt-3">

        <div class="card-header error-header">
            <div>
                <h5>
                    Invalid Records
                </h5>

                <small>
                    Review the failed records below.
                </small>
            </div>
            <a asp-action="DownloadFailedRecords"
               class="btn btn-danger">

                Download Failed Records
            </a>
        </div>

        <div class="card-body">

            <table id="errorTable" class="table table-bordered error-table">

                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Employee Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Error</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Result.Errors)
                    {
                        <tr>

                            <td>
                                @item.RowNumber
                            </td>

                            <td>
                                @item.EmployeeData.EmployeeCode
                            </td>

                            <td>
                                @item.EmployeeData.Name
                            </td>

                            <td>
                                @item.EmployeeData.DepartmentName
                            </td>

                            <td>
                                @item.ErrorMessage
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    @if (TempData["Message"] != null)
    {
        <script>
            Swal.fire({
                icon: '@((bool)TempData["Success"] ? "success" : "error")',
                title: '@((bool)TempData["Success"] ? "Success" : "Error")',
                text: @Html.Raw(JsonSerializer.Serialize(TempData["Message"]))
            });
        </script>
    }
}