@model PaginationViewModel<EmployeeViewModel>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle employee-table">
        <thead class="table-dark">
            <tr>
                <th>S.No</th>
                <th>Employee Id</th>
                <th>Name</th>
                <th>Gender</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Department</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Data.Any())
            {
                int sno = ((Model.PageNumber - 1) * Model.PageSize) + 1;

                @foreach (var item in Model.Data)
                {
                    <tr class="employee-row"
                        onclick="window.location='@Url.Action("Details", "Home", new { id = item.Id })'">
                        <td>@sno</td>

                        <td>@item.EmployeeCode</td>

                        <td>@item.Name</td>

                        <td>@item.Gender</td>

                        <td>@item.EmailId</td>

                        <td>@item.Mobile</td>

                        <td>
                            @(item.DepartmentName ?? "Department Not Assigned")
                        </td>

                        <td class="action-cell">
                            <a asp-action="Edit" asp-controller="Home" asp-route-id="@item.Id" class="btn btn-success btn-sm" onclick="event.stopPropagation()">Edit</a>
                            <form asp-action="Delete" asp-controller="Home" asp-route-id="@item.Id" class="delete-form" onclick="event.stopPropagation()">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                    sno++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        No Records Found
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="mt-3">
        <ul class="pagination">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item
                    @(Model.PageNumber == i
                                                        ? "active"
                                                        : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchText="@Model.SearchText"
                       asp-route-pageSize="@Model.PageSize">
                        @i
                    </a>
                </li>
            }

        </ul>
    </nav>
</div>
