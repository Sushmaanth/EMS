@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var name = Context.Session.GetString("EmployeeName");
    var email = Context.Session.GetString("EmailId");

    var initials = "?";

    if (!string.IsNullOrEmpty(email))
    {
        initials = email.Substring(0, 1).ToUpper();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMSFrontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Employee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EMSFrontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="app-layout">

        <aside class="sidebar">
            <div class="sidebar-header">
                EMS App
            </div>
            <nav class="sidebar-menu">

                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="sidebar-link @(currentAction == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Employee"
                   asp-action="Documents"
                   class="sidebar-link @(currentAction == "Documents" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Documents</span>
                </a>

            </nav>
            <div class="sidebar-user">
                <div class="user-avatar">
                    @initials
                </div>

                <div class="user-details">
                    <div class="user-name">
                        @name
                    </div>

                    <div class="user-email">
                        @email
                    </div>
                </div>

                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="logout-link">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </a>
            </div>
    </aside>
        <div class="mobile-header d-md-none">

            <button class="btn mobile-menu-btn"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar">

                <i class="bi bi-list"></i>

            </button>

            <span class="mobile-title">
                EMS App
            </span>

        </div>

        <div class="offcanvas offcanvas-start"
             tabindex="-1"
             id="mobileSidebar">

            <div class="offcanvas-header">
                <h5 class="offcanvas-title">
                    EMS App
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas">
                </button>
            </div>

            <div class="offcanvas-body">
                <div class="offcanvas-body">
                    <nav class="sidebar-menu">

                        <a asp-controller="Employee"
                           asp-action="Dashboard"
                           class="sidebar-link @(currentAction == "Dashboard" ? "active" : "")">

                            <i class="bi bi-grid"></i>
                            Dashboard

                        </a>

                        <a asp-controller="Employee"
                           asp-action="Documents"
                           class="sidebar-link @(currentAction == "Documents" ? "active" : "")">

                            <i class="bi bi-file-earmark-text"></i>
                            Documents

                        </a>

                    </nav>
                    <div class="sidebar-user">

                        <div class="user-avatar">
                            @initials
                        </div>

                        <div class="user-name">
                            @name
                        </div>

                        <div class="user-email">
                            @email
                        </div>

                        <a asp-controller="Auth"
                           asp-action="Logout"
                           class="logout-link">

                            <i class="bi bi-box-arrow-right"></i>
                            Logout

                        </a>

                    </div>
                </div>
            </div>

        </div>
    <main class="content">
        @RenderBody()
    </main>

</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site1.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
