@model EMSFrontend.Models.AccountActivationViewModel
@{
    Layout = "_Layout1";
    ViewBag.Title = "Account Activation";
}

<div class="card w-100 employee-activation" style="max-width: 420px;">
    <div class="card-body p-4 p-sm-5">
        
      
        <div class="text-center mb-4">
            <h4 class="fw-bold text-dark mb-1">Activate Your Account</h4>
            <p class="text-muted small">Set up your credentials to get started</p>
        </div>

        
        <form asp-action="ActivateAccount" method="POST">
            
        
            <div class="mb-3">
                <label asp-for="EmailId" class="form-label text-secondary small fw-medium">Email Address</label>
                <input 
                    type="email" 
                    class="form-control form-control-modern" 
                    asp-for="EmailId"
                    placeholder="email@example.com" 
                >
                <span asp-validation-for="EmailId" class="text-danger"></span>
            </div>

          
            <div class="mb-3">
                <label  asp-for="Password" class="form-label text-secondary small fw-medium">Password</label>
                <input 
                    type="password" 
                    class="form-control form-control-modern" 
                     asp-for="Password" 
                    placeholder="********" 
                >
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

          
            <div class="mb-4">
                <label  asp-for="ConfirmPassword" class="form-label text-secondary small fw-medium">Confirm Password</label>
                <input 
                    type="password" 
                    class="form-control form-control-modern" 
                     asp-for="ConfirmPassword"
                    placeholder="********" 
                >
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

           
            <button type="submit" class="btn btn-primary btn-modern w-100 mb-4">
                Activate Account
            </button>

         
            <div class="text-center pt-2 border-top border-light-subtle">
                <p class="text-muted small mb-0">
                    Already have an account? 
                    <a asp-action="Login" class="text-decoration-none text-primary fw-semibold ms-1">Login</a>
                </p>
            </div>
            
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}