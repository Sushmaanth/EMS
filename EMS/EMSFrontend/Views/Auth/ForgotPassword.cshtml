@model EMSFrontend.Models.ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewBag.Title = "Forgot Password";
}

<div class="card w-100 employee-login" style="max-width:420px;">
    <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-3">
            <h4 class="fw-bold text-dark mb-1">Forgot Password</h4>
            <p class="text-muted small">Enter your email address</p>
        </div>

        <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-secondary small fw-medium mb-0">Email</label>
                <input asp-for="Email" class="form-control form-control-modern" placeholder="email@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100"> Send Reset Link </button>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}