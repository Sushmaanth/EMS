@model EMSFrontend.Models.ResetPasswordViewModel

@{
    Layout = "_Layout1";
    ViewBag.Title = "Reset Password";
}

<div class="card w-100 employee-login" style="max-width: 500px;">
    <div class="card-body p-4 p-sm-5">

        <div class="text-center mb-4">
            <h4 class="fw-bold text-dark mb-1">Reset Password</h4>
            <p class="text-muted small">
                Enter your new password below
            </p>
        </div>

        <form method="post" asp-action="ResetPassword" asp-controller="Auth">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label text-secondary small fw-medium">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Otp" class="form-label text-secondary small fw-medium">Otp</label>
                    <input type="number" asp-for="Otp" class="form-control" placeholder="Enter OTP" />
                    <span asp-validation-for="Otp" class="text-danger"></span>
                </div>

                <div class=" col-md-6 mb-3">
                    <label asp-for="NewPassword" class="form-label text-secondary small fw-medium">New Password</label>
                    <input type="password" class="form-control form-control-modern" placeholder="Enter new password" asp-for="NewPassword" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-secondary small fw-medium">Confirm Password</label>
                    <input type="password" class="form-control form-control-modern" placeholder="Re-enter new password" asp-for="ConfirmPassword" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary btn-modern w-100 mb-1"> Reset Password</button>
      
            <div class="text-center pt-2 border-top border-light-subtle">
                <a asp-action="Login" asp-controller="Auth" class="text-decoration-none text-primary fw-semibold small">
                    Back to Login
                </a>
            </div>

        </form>
    </div>
</div>

@if (TempData["OTPSentSuccessMessage"] != null)
{
    <input type="hidden"
           id="oTPSentSuccessMessage"
           value="@TempData["OTPSentSuccessMessage"]" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}