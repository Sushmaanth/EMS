@model EMSFrontend.Models.LoginViewModel

@{
    Layout = "_Layout1";
    ViewBag.Title = "Login";
}
<div class="card w-100 employee-login" style="max-width: 420px;">
        <div class="card-body p-4 p-sm-5">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-dark mb-1">Welcome Back</h4>
                <p class="text-muted small">Please enter your details to sign in</p>
            </div>

            <form asp-action="Login" asp-controller="Auth" method="POST">
                
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary small fw-medium">Email Address</label>
                    <input 
                        type="email" 
                        class="form-control form-control-modern"  
                        placeholder="email@example.com" 
                        asp-for="Email"
                    >
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label text-secondary small fw-medium mb-0">Password</label>
                        <a href="#" class="text-decoration-none small text-primary fw-medium">Forgot?</a>
                    </div>
                    <input 
                        type="password" 
                        class="form-control form-control-modern" 
                        placeholder="********" 
                        asp-for="Password"
                    >
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-modern w-100 mb-3">
                    Sign In
                </button>

                <div class="text-center pt-0 mt-0 border-top border-light-subtle mb-3">
                    <p class="text-muted small mb-0">
                        Account activation not done? 
                        <a asp-action="ActivateAccount" class="text-decoration-none text-primary fw-semibold ms-1">Activate Account</a>
                    </p>
                </div>

                <a asp-action="MicrosoftLogin" asp-controller="Auth" class="btn microsoft-btn w-100"><img src="~/images/microsoft-svgrepo-com.svg" alt="microsoft logo" class="ms-logo"/>Sign in with Microsoft</a>
            </form>
        </div>
    </div>

@if (TempData["SuccessfullyAccountActivated"] != null)
{
    <input type="hidden"
           id="successfullyAccountActivated"
           value="@TempData["SuccessfullyAccountActivated"]" />
}

@if (TempData["SessionExpired"] != null)
{
    <input type="hidden"
           id="sessionExpired"
           value="@TempData["SessionExpired"]" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}